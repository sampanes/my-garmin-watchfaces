        if (pet == 1) { return [1, 1, 62, 74, 31, 31, 56, 73, 1, 65, 79, 32, 32, 59, 142, 1, 57, 69, 28, 29, 54, 209, 1, 62, 74, 30, -1, -1, 1, 82, 70, 62, 35, -1, -1, 73, 82, 67, 75, 33, 34, 52, 142, 82, 65, 80, 32, 32, 54, 209, 82, 69, 76, 34, 35, 54, 1, 164, 60, 82, 29, 29, 56, 73, 164, 62, 83, 32, 33, 57, 142, 164, 63, 68, 32, 32, 55, 209, 164, 58, 65, 29, -1, -1] as Lang.Array<Lang.Number>; }
        if (pet == 2) { return [1, 1, 57, 82, 28, 28, 56, 61, 1, 58, 87, 29, 29, 58, 123, 1, 58, 73, 29, 29, 51, 186, 1, 60, 86, 30, -1, -1, 1, 90, 58, 69, 29, 29, 53, 61, 90, 60, 81, 30, 30, 57, 123, 90, 59, 88, 30, 30, 57, 186, 90, 61, 87, 31, 31, 56, 1, 180, 58, 92, 29, 29, 57, 61, 180, 58, 94, 29, 29, 59, 123, 180, 61, 80, 31, 30, 57, 186, 180, 59, 73, 31, -1, -1] as Lang.Array<Lang.Number>; }
