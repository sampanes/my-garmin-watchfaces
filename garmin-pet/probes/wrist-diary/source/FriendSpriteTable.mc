// Emblem 1 to 16 (0 is a bare belly); the caller catches a refusal.
function loadFriendEmblem(emblem as Lang.Number) as Graphics.BitmapType? {
    if (emblem == 1) { return WatchUi.loadResource(Rez.Drawables.EmblemHeart) as Graphics.BitmapType; }
    if (emblem == 2) { return WatchUi.loadResource(Rez.Drawables.EmblemStar) as Graphics.BitmapType; }
    if (emblem == 3) { return WatchUi.loadResource(Rez.Drawables.EmblemLeaf) as Graphics.BitmapType; }
    if (emblem == 4) { return WatchUi.loadResource(Rez.Drawables.EmblemSwirl) as Graphics.BitmapType; }
    if (emblem == 5) { return WatchUi.loadResource(Rez.Drawables.EmblemPaw) as Graphics.BitmapType; }
    if (emblem == 6) { return WatchUi.loadResource(Rez.Drawables.EmblemApple) as Graphics.BitmapType; }
    if (emblem == 7) { return WatchUi.loadResource(Rez.Drawables.EmblemMountain) as Graphics.BitmapType; }
    if (emblem == 8) { return WatchUi.loadResource(Rez.Drawables.EmblemWing) as Graphics.BitmapType; }
    if (emblem == 9) { return WatchUi.loadResource(Rez.Drawables.EmblemCrown) as Graphics.BitmapType; }
    if (emblem == 10) { return WatchUi.loadResource(Rez.Drawables.EmblemBolt) as Graphics.BitmapType; }
    if (emblem == 11) { return WatchUi.loadResource(Rez.Drawables.EmblemFlame) as Graphics.BitmapType; }
    if (emblem == 12) { return WatchUi.loadResource(Rez.Drawables.EmblemDumbbell) as Graphics.BitmapType; }
    if (emblem == 13) { return WatchUi.loadResource(Rez.Drawables.EmblemSun) as Graphics.BitmapType; }
    if (emblem == 14) { return WatchUi.loadResource(Rez.Drawables.EmblemMoon) as Graphics.BitmapType; }
    if (emblem == 15) { return WatchUi.loadResource(Rez.Drawables.EmblemFlower) as Graphics.BitmapType; }
    if (emblem == 16) { return WatchUi.loadResource(Rez.Drawables.EmblemGem) as Graphics.BitmapType; }
    return null;
}
