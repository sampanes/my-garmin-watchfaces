        if (pet == 3) { return [1, 1, 153, 151, 76, 78, 108, 170, 1, 155, 164, 78, 80, 113, 333, 1, 142, 141, 71, 72, 106, 494, 1, 155, 155, 77, -1, -1, 1, 167, 167, 130, 84, 85, 99, 170, 167, 161, 156, 80, 81, 103, 333, 167, 159, 165, 79, 81, 110, 494, 167, 164, 165, 82, 84, 110, 1, 334, 158, 179, 78, 80, 117, 170, 334, 154, 180, 79, 78, 118, 333, 334, 157, 155, 78, 79, 111, 494, 334, 158, 152, 78, -1, -1] as Lang.Array<Lang.Number>; }
        if (pet == 4) { return [1, 1, 122, 155, 58, 57, 112, 131, 1, 125, 164, 60, 60, 115, 259, 1, 118, 139, 56, 54, 105, 387, 1, 115, 160, 57, -1, -1, 1, 167, 128, 130, 59, 59, 104, 131, 167, 126, 150, 64, 63, 105, 259, 167, 123, 161, 63, 61, 108, 387, 167, 127, 160, 65, 64, 109, 1, 330, 116, 174, 57, 56, 112, 131, 330, 115, 176, 58, 57, 113, 259, 330, 126, 151, 59, 57, 110, 387, 330, 126, 142, 60, -1, -1] as Lang.Array<Lang.Number>; }
    } else {
