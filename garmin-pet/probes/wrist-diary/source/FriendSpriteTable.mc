        if (pet == 0) { return [1, 1, 103, 107, 51, -1, -1, 111, 1, 103, 114, 51, -1, -1, 216, 1, 109, 101, 54, -1, -1, 327, 1, 103, 107, 51, -1, -1, 1, 117, 108, 84, 54, -1, -1, 111, 117, 103, 110, 51, -1, -1, 111, 117, 103, 110, 51, -1, -1, 216, 117, 107, 110, 53, -1, -1, 1, 117, 108, 84, 54, -1, -1, 111, 117, 103, 110, 51, -1, -1, 216, 117, 107, 110, 53, -1, -1, 327, 117, 115, 92, 57, -1, -1] as Lang.Array<Lang.Number>; }
