// The strip of one character in one colorway; the caller catches a refusal.
function loadFriendStrip(pet as Lang.Number, pal as Lang.Number,
                         small as Lang.Boolean) as Graphics.BitmapType? {
    var k = pet * 6 + pal;
    if (!small) {
        if (k == 0) { return WatchUi.loadResource(Rez.Drawables.PetNubMint) as Graphics.BitmapType; }
        if (k == 1) { return WatchUi.loadResource(Rez.Drawables.PetNubPeach) as Graphics.BitmapType; }
        if (k == 2) { return WatchUi.loadResource(Rez.Drawables.PetNubSky) as Graphics.BitmapType; }
        if (k == 3) { return WatchUi.loadResource(Rez.Drawables.PetNubLilac) as Graphics.BitmapType; }
        if (k == 4) { return WatchUi.loadResource(Rez.Drawables.PetNubSun) as Graphics.BitmapType; }
        if (k == 5) { return WatchUi.loadResource(Rez.Drawables.PetNubRose) as Graphics.BitmapType; }
        if (k == 6) { return WatchUi.loadResource(Rez.Drawables.PetSprigMint) as Graphics.BitmapType; }
        if (k == 7) { return WatchUi.loadResource(Rez.Drawables.PetSprigPeach) as Graphics.BitmapType; }
        if (k == 8) { return WatchUi.loadResource(Rez.Drawables.PetSprigSky) as Graphics.BitmapType; }
        if (k == 9) { return WatchUi.loadResource(Rez.Drawables.PetSprigLilac) as Graphics.BitmapType; }
        if (k == 10) { return WatchUi.loadResource(Rez.Drawables.PetSprigSun) as Graphics.BitmapType; }
        if (k == 11) { return WatchUi.loadResource(Rez.Drawables.PetSprigRose) as Graphics.BitmapType; }
        if (k == 12) { return WatchUi.loadResource(Rez.Drawables.PetDashMint) as Graphics.BitmapType; }
