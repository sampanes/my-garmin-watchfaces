        if (k == 29) { return WatchUi.loadResource(Rez.Drawables.PetScampRose) as Graphics.BitmapType; }
    } else {
        if (k == 0) { return WatchUi.loadResource(Rez.Drawables.PetNubMintS) as Graphics.BitmapType; }
