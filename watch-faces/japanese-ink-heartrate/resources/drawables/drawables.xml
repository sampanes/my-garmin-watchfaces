<drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <bitmap id="LauncherIcon" filename="launcher_icon.png" />
    <!-- Fixed planes, day set: ink on paper. Only one set is loaded at a time. -->
    <bitmap id="MistBandTuned" filename="mist_band.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="MistBandLiteTuned" filename="mist_band_lite.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="PaperGrainTuned" filename="paper_grain.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <!-- Fixed planes, night set: pale ink for black paper (no grain). -->
    <bitmap id="MistBandNight" filename="mist_band_night.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="MistBandLiteNight" filename="mist_band_lite_night.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <!-- The foreground is one of the whole-face paintings in foregrounds.xml
         (scripts/bake_foregrounds.py), loaded per render. -->
    <!-- The relief: the level horizon and the near hills as paper cutouts baked by
         scripts/bake_cutouts.py. The masses are the shape library (shapes.xml, from
         scripts/gen_shape_library.py). Loaded per render and dropped, never held. -->
    <bitmap id="Horizon" filename="horizon.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="NearHillCut" filename="near_hill_cut.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="NearHill2Cut" filename="near_hill2_cut.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="HorizonNight" filename="horizon_night.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="NearHillCutNight" filename="near_hill_cut_night.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
    <bitmap id="NearHill2CutNight" filename="near_hill2_cut_night.png" dithering="none" automaticPalette="false" packingFormat="png" compress="false" />
</drawables>
