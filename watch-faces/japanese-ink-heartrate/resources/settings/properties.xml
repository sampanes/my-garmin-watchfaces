<properties>
    <!-- Draw the window's HR samples as a translucent silhouette on the
         landscape's own axis and crest scale, with a dot on each painted
         crest: the data against the painting. -->
    <property id="trueHrOverlay" type="boolean">true</property>
    <!-- The red seal under the time carries the live HR; false = the date,
         month over day. -->
    <property id="sealHr" type="boolean">true</property>
    <!-- Rain, snow, a storm or wind painted over the scene, from the
         phone's current conditions. -->
    <property id="weather" type="boolean">true</property>
    <!-- Night mode window (hours, 0-24): black paper, pale ink. Equal = off. -->
    <property id="nightStart" type="number">21</property>
    <property id="nightEnd" type="number">6</property>
    <!-- The foreground painting: 0 = by season (the month), 1..5 = spring,
         summer, autumn, winter, mountain pass (scripts/bake_foregrounds.py). -->
    <property id="foreground" type="number">0</property>
</properties>
