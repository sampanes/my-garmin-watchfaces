using Toybox.Graphics;
using Toybox.Lang;
using Toybox.WatchUi;

// Generated by scripts/bake_foregrounds.py; do not edit.
// The foregrounds: 10 whole-face paintings, 416 px square, drawn over
// the whole face. Index = season * FG_PAINTERS + painter, seasons in order
// spring, summer, autumn, winter, pass;
// painter 0 is ChatGPT's, 1 Gemini's.

const FG_COUNT = 10;
const FG_SEASONS = 5;
const FG_PAINTERS = 2;

// Foreground i, day or night; the caller catches a refusal.
function loadForegroundBitmap(i as Lang.Number, night as Lang.Boolean) as Graphics.BitmapType? {
    if (!night) {
        if (i == 0) { return WatchUi.loadResource(Rez.Drawables.FgSpringB) as Graphics.BitmapType; }
        if (i == 1) { return WatchUi.loadResource(Rez.Drawables.FgSpringA) as Graphics.BitmapType; }
        if (i == 2) { return WatchUi.loadResource(Rez.Drawables.FgSummerB) as Graphics.BitmapType; }
        if (i == 3) { return WatchUi.loadResource(Rez.Drawables.FgSummerA) as Graphics.BitmapType; }
        if (i == 4) { return WatchUi.loadResource(Rez.Drawables.FgAutumnB) as Graphics.BitmapType; }
        if (i == 5) { return WatchUi.loadResource(Rez.Drawables.FgAutumnC) as Graphics.BitmapType; }
        if (i == 6) { return WatchUi.loadResource(Rez.Drawables.FgWinterB) as Graphics.BitmapType; }
        if (i == 7) { return WatchUi.loadResource(Rez.Drawables.FgWinterC) as Graphics.BitmapType; }
        if (i == 8) { return WatchUi.loadResource(Rez.Drawables.FgPassB) as Graphics.BitmapType; }
        if (i == 9) { return WatchUi.loadResource(Rez.Drawables.FgPassC) as Graphics.BitmapType; }
    }
    if (night) {
        if (i == 0) { return WatchUi.loadResource(Rez.Drawables.FgSpringBNight) as Graphics.BitmapType; }
        if (i == 1) { return WatchUi.loadResource(Rez.Drawables.FgSpringANight) as Graphics.BitmapType; }
        if (i == 2) { return WatchUi.loadResource(Rez.Drawables.FgSummerBNight) as Graphics.BitmapType; }
        if (i == 3) { return WatchUi.loadResource(Rez.Drawables.FgSummerANight) as Graphics.BitmapType; }
        if (i == 4) { return WatchUi.loadResource(Rez.Drawables.FgAutumnBNight) as Graphics.BitmapType; }
        if (i == 5) { return WatchUi.loadResource(Rez.Drawables.FgAutumnCNight) as Graphics.BitmapType; }
        if (i == 6) { return WatchUi.loadResource(Rez.Drawables.FgWinterBNight) as Graphics.BitmapType; }
        if (i == 7) { return WatchUi.loadResource(Rez.Drawables.FgWinterCNight) as Graphics.BitmapType; }
        if (i == 8) { return WatchUi.loadResource(Rez.Drawables.FgPassBNight) as Graphics.BitmapType; }
        if (i == 9) { return WatchUi.loadResource(Rez.Drawables.FgPassCNight) as Graphics.BitmapType; }
    }
    return null;
}
