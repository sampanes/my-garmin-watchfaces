using Toybox.Graphics;
using Toybox.Lang;
using Toybox.WatchUi;

// Generated by scripts/bake_planes.py; do not edit.
// The fixed planes from the ChatGPT strip sheet: the far range (the
// horizon), the two mist bands and the near hills. Sizes are the PNGs'
// on a 416 px face; a crest is the topmost row with ink (alpha >= 40),
// at the middle of that row's inked columns, as compose_preview.measure_apex
// reads it.

const HORIZON_W = 416.0;    // horizon.png, drawn full width at native height
const HORIZON_H = 41.0;
const HORIZON_APEX_Y = 0.0732;
const MIST_W = 441;         // mist_band.png, as drawn on the face (the probe draws it 1:1)
const MIST_H = 92;
const MIST_LITE_W = 499;    // mist_band_lite.png
const MIST_LITE_H = 71;
const NEAR_PLANES = 2;

// The near hills by index (the Scene's P_NEAR, P_NEAR2): the PNG's width
// over its height, and the crest inside it (fractions of the bitmap).
function planeAspect() as Lang.Array<Lang.Float> {
    return [2.0000, 2.0000] as Lang.Array<Lang.Float>;
}

function planeApexX() as Lang.Array<Lang.Float> {
    return [0.5672, 0.5156] as Lang.Array<Lang.Float>;
}

function planeApexY() as Lang.Array<Lang.Float> {
    return [0.0437, 0.0500] as Lang.Array<Lang.Float>;
}

// Each plane, day or night; the caller catches a refusal.
function loadHorizonBitmap(night as Lang.Boolean) as Graphics.BitmapType? {
    if (night) { return WatchUi.loadResource(Rez.Drawables.HorizonNight) as Graphics.BitmapType; }
    return WatchUi.loadResource(Rez.Drawables.Horizon) as Graphics.BitmapType;
}

function loadMistBitmap(lite as Lang.Boolean, night as Lang.Boolean) as Graphics.BitmapType? {
    if (lite && night) { return WatchUi.loadResource(Rez.Drawables.MistBandLiteNight) as Graphics.BitmapType; }
    if (lite) { return WatchUi.loadResource(Rez.Drawables.MistBandLite) as Graphics.BitmapType; }
    if (night) { return WatchUi.loadResource(Rez.Drawables.MistBandNight) as Graphics.BitmapType; }
    return WatchUi.loadResource(Rez.Drawables.MistBand) as Graphics.BitmapType;
}

function loadNearBitmap(p as Lang.Number, night as Lang.Boolean) as Graphics.BitmapType? {
    if (p == 0) { return night ? WatchUi.loadResource(Rez.Drawables.NearHillNight) as Graphics.BitmapType : WatchUi.loadResource(Rez.Drawables.NearHill) as Graphics.BitmapType; }
    if (p == 1) { return night ? WatchUi.loadResource(Rez.Drawables.NearHill2Night) as Graphics.BitmapType : WatchUi.loadResource(Rez.Drawables.NearHill2) as Graphics.BitmapType; }
    return null;
}
