// One shape's cutout, day or night; the caller catches a refusal.
function loadShapeBitmap(i as Lang.Number, night as Lang.Boolean) as Graphics.BitmapType? {
    if (!night) {
        if (i == 0) { return WatchUi.loadResource(Rez.Drawables.ShapePeak) as Graphics.BitmapType; }
        if (i == 1) { return WatchUi.loadResource(Rez.Drawables.ShapeDome) as Graphics.BitmapType; }
        if (i == 2) { return WatchUi.loadResource(Rez.Drawables.ShapePlateau) as Graphics.BitmapType; }
        if (i == 3) { return WatchUi.loadResource(Rez.Drawables.ShapeRidge3) as Graphics.BitmapType; }
        if (i == 4) { return WatchUi.loadResource(Rez.Drawables.ShapeRampUp) as Graphics.BitmapType; }
        if (i == 5) { return WatchUi.loadResource(Rez.Drawables.ShapeRampDown) as Graphics.BitmapType; }
        if (i == 6) { return WatchUi.loadResource(Rez.Drawables.ShapeSpire) as Graphics.BitmapType; }
        if (i == 7) { return WatchUi.loadResource(Rez.Drawables.ShapeTwin) as Graphics.BitmapType; }
        if (i == 8) { return WatchUi.loadResource(Rez.Drawables.ShapeLeanL) as Graphics.BitmapType; }
        if (i == 9) { return WatchUi.loadResource(Rez.Drawables.ShapeLeanR) as Graphics.BitmapType; }
        if (i == 10) { return WatchUi.loadResource(Rez.Drawables.ShapeBroad) as Graphics.BitmapType; }
        if (i == 11) { return WatchUi.loadResource(Rez.Drawables.ShapeTeeth) as Graphics.BitmapType; }
        if (i == 12) { return WatchUi.loadResource(Rez.Drawables.ShapeCliffL) as Graphics.BitmapType; }
        if (i == 13) { return WatchUi.loadResource(Rez.Drawables.ShapeCliffR) as Graphics.BitmapType; }
        if (i == 14) { return WatchUi.loadResource(Rez.Drawables.ShapeTwoTier) as Graphics.BitmapType; }
        if (i == 15) { return WatchUi.loadResource(Rez.Drawables.ShapeSpires3) as Graphics.BitmapType; }
        if (i == 16) { return WatchUi.loadResource(Rez.Drawables.ShapeTwinDomes) as Graphics.BitmapType; }
        if (i == 17) { return WatchUi.loadResource(Rez.Drawables.ShapeConeShoulder) as Graphics.BitmapType; }
        if (i == 18) { return WatchUi.loadResource(Rez.Drawables.ShapeNotch) as Graphics.BitmapType; }
        if (i == 19) { return WatchUi.loadResource(Rez.Drawables.ShapeCrag) as Graphics.BitmapType; }
        if (i == 20) { return WatchUi.loadResource(Rez.Drawables.ShapeWedge) as Graphics.BitmapType; }
        if (i == 21) { return WatchUi.loadResource(Rez.Drawables.ShapeHeadlandL) as Graphics.BitmapType; }
        if (i == 22) { return WatchUi.loadResource(Rez.Drawables.ShapeHeadlandR) as Graphics.BitmapType; }
        if (i == 23) { return WatchUi.loadResource(Rez.Drawables.ShapeTallPeak) as Graphics.BitmapType; }
    }
    if (night) {
        if (i == 0) { return WatchUi.loadResource(Rez.Drawables.ShapePeakNight) as Graphics.BitmapType; }
        if (i == 1) { return WatchUi.loadResource(Rez.Drawables.ShapeDomeNight) as Graphics.BitmapType; }
        if (i == 2) { return WatchUi.loadResource(Rez.Drawables.ShapePlateauNight) as Graphics.BitmapType; }
        if (i == 3) { return WatchUi.loadResource(Rez.Drawables.ShapeRidge3Night) as Graphics.BitmapType; }
        if (i == 4) { return WatchUi.loadResource(Rez.Drawables.ShapeRampUpNight) as Graphics.BitmapType; }
        if (i == 5) { return WatchUi.loadResource(Rez.Drawables.ShapeRampDownNight) as Graphics.BitmapType; }
        if (i == 6) { return WatchUi.loadResource(Rez.Drawables.ShapeSpireNight) as Graphics.BitmapType; }
        if (i == 7) { return WatchUi.loadResource(Rez.Drawables.ShapeTwinNight) as Graphics.BitmapType; }
        if (i == 8) { return WatchUi.loadResource(Rez.Drawables.ShapeLeanLNight) as Graphics.BitmapType; }
        if (i == 9) { return WatchUi.loadResource(Rez.Drawables.ShapeLeanRNight) as Graphics.BitmapType; }
        if (i == 10) { return WatchUi.loadResource(Rez.Drawables.ShapeBroadNight) as Graphics.BitmapType; }
        if (i == 11) { return WatchUi.loadResource(Rez.Drawables.ShapeTeethNight) as Graphics.BitmapType; }
        if (i == 12) { return WatchUi.loadResource(Rez.Drawables.ShapeCliffLNight) as Graphics.BitmapType; }
        if (i == 13) { return WatchUi.loadResource(Rez.Drawables.ShapeCliffRNight) as Graphics.BitmapType; }
        if (i == 14) { return WatchUi.loadResource(Rez.Drawables.ShapeTwoTierNight) as Graphics.BitmapType; }
        if (i == 15) { return WatchUi.loadResource(Rez.Drawables.ShapeSpires3Night) as Graphics.BitmapType; }
        if (i == 16) { return WatchUi.loadResource(Rez.Drawables.ShapeTwinDomesNight) as Graphics.BitmapType; }
        if (i == 17) { return WatchUi.loadResource(Rez.Drawables.ShapeConeShoulderNight) as Graphics.BitmapType; }
        if (i == 18) { return WatchUi.loadResource(Rez.Drawables.ShapeNotchNight) as Graphics.BitmapType; }
        if (i == 19) { return WatchUi.loadResource(Rez.Drawables.ShapeCragNight) as Graphics.BitmapType; }
        if (i == 20) { return WatchUi.loadResource(Rez.Drawables.ShapeWedgeNight) as Graphics.BitmapType; }
        if (i == 21) { return WatchUi.loadResource(Rez.Drawables.ShapeHeadlandLNight) as Graphics.BitmapType; }
        if (i == 22) { return WatchUi.loadResource(Rez.Drawables.ShapeHeadlandRNight) as Graphics.BitmapType; }
        if (i == 23) { return WatchUi.loadResource(Rez.Drawables.ShapeTallPeakNight) as Graphics.BitmapType; }
    }
    return null;
}
