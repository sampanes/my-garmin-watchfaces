using Toybox.Graphics;
using Toybox.Lang;
using Toybox.WatchUi;

// Generated by scripts/bake_trees.py; do not edit.
// The ridge trees: 8 tree silhouettes, each baked at 3 heights (treeSizes()),
// drawn 1:1. treeW() and treeFoot() hold, tree after tree and size after size,
// the bitmap's width and the x of its foot (where the trunk meets the ridge).

const TREE_COUNT = 8;
const TREE_SIZES = 3;

function treeSizes() as Lang.Array<Lang.Number> {
    return [12, 16, 22] as Lang.Array<Lang.Number>;
}

function treeW() as Lang.Array<Lang.Number> {
    return [7, 10, 13, 14, 18, 25, 12, 17, 23, 12, 16, 22, 12, 16, 22, 14, 18, 25, 7, 9, 13, 4, 5, 7] as Lang.Array<Lang.Number>;
}

function treeFoot() as Lang.Array<Lang.Number> {
    return [3, 4, 6, 6, 8, 11, 9, 12, 18, 0, 1, 2, 4, 8, 12, 4, 8, 12, 3, 4, 6, 1, 2, 2] as Lang.Array<Lang.Number>;
}

// Tree i at size k, day or night; the caller catches a refusal.
function loadTreeBitmap(i as Lang.Number, k as Lang.Number, night as Lang.Boolean) as Graphics.BitmapType? {
    var c = i * TREE_SIZES + k;
    if (!night) {
        if (c == 0) { return WatchUi.loadResource(Rez.Drawables.TreePineNarrow12) as Graphics.BitmapType; }
        if (c == 1) { return WatchUi.loadResource(Rez.Drawables.TreePineNarrow16) as Graphics.BitmapType; }
        if (c == 2) { return WatchUi.loadResource(Rez.Drawables.TreePineNarrow22) as Graphics.BitmapType; }
        if (c == 3) { return WatchUi.loadResource(Rez.Drawables.TreePineWide12) as Graphics.BitmapType; }
        if (c == 4) { return WatchUi.loadResource(Rez.Drawables.TreePineWide16) as Graphics.BitmapType; }
        if (c == 5) { return WatchUi.loadResource(Rez.Drawables.TreePineWide22) as Graphics.BitmapType; }
        if (c == 6) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanL12) as Graphics.BitmapType; }
        if (c == 7) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanL16) as Graphics.BitmapType; }
        if (c == 8) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanL22) as Graphics.BitmapType; }
        if (c == 9) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanR12) as Graphics.BitmapType; }
        if (c == 10) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanR16) as Graphics.BitmapType; }
        if (c == 11) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanR22) as Graphics.BitmapType; }
        if (c == 12) { return WatchUi.loadResource(Rez.Drawables.TreePines212) as Graphics.BitmapType; }
        if (c == 13) { return WatchUi.loadResource(Rez.Drawables.TreePines216) as Graphics.BitmapType; }
        if (c == 14) { return WatchUi.loadResource(Rez.Drawables.TreePines222) as Graphics.BitmapType; }
        if (c == 15) { return WatchUi.loadResource(Rez.Drawables.TreePines312) as Graphics.BitmapType; }
        if (c == 16) { return WatchUi.loadResource(Rez.Drawables.TreePines316) as Graphics.BitmapType; }
        if (c == 17) { return WatchUi.loadResource(Rez.Drawables.TreePines322) as Graphics.BitmapType; }
        if (c == 18) { return WatchUi.loadResource(Rez.Drawables.TreeFir12) as Graphics.BitmapType; }
        if (c == 19) { return WatchUi.loadResource(Rez.Drawables.TreeFir16) as Graphics.BitmapType; }
        if (c == 20) { return WatchUi.loadResource(Rez.Drawables.TreeFir22) as Graphics.BitmapType; }
        if (c == 21) { return WatchUi.loadResource(Rez.Drawables.TreeCypress12) as Graphics.BitmapType; }
        if (c == 22) { return WatchUi.loadResource(Rez.Drawables.TreeCypress16) as Graphics.BitmapType; }
        if (c == 23) { return WatchUi.loadResource(Rez.Drawables.TreeCypress22) as Graphics.BitmapType; }
    }
    if (night) {
        if (c == 0) { return WatchUi.loadResource(Rez.Drawables.TreePineNarrow12Night) as Graphics.BitmapType; }
        if (c == 1) { return WatchUi.loadResource(Rez.Drawables.TreePineNarrow16Night) as Graphics.BitmapType; }
        if (c == 2) { return WatchUi.loadResource(Rez.Drawables.TreePineNarrow22Night) as Graphics.BitmapType; }
        if (c == 3) { return WatchUi.loadResource(Rez.Drawables.TreePineWide12Night) as Graphics.BitmapType; }
        if (c == 4) { return WatchUi.loadResource(Rez.Drawables.TreePineWide16Night) as Graphics.BitmapType; }
        if (c == 5) { return WatchUi.loadResource(Rez.Drawables.TreePineWide22Night) as Graphics.BitmapType; }
        if (c == 6) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanL12Night) as Graphics.BitmapType; }
        if (c == 7) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanL16Night) as Graphics.BitmapType; }
        if (c == 8) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanL22Night) as Graphics.BitmapType; }
        if (c == 9) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanR12Night) as Graphics.BitmapType; }
        if (c == 10) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanR16Night) as Graphics.BitmapType; }
        if (c == 11) { return WatchUi.loadResource(Rez.Drawables.TreePineLeanR22Night) as Graphics.BitmapType; }
        if (c == 12) { return WatchUi.loadResource(Rez.Drawables.TreePines212Night) as Graphics.BitmapType; }
        if (c == 13) { return WatchUi.loadResource(Rez.Drawables.TreePines216Night) as Graphics.BitmapType; }
        if (c == 14) { return WatchUi.loadResource(Rez.Drawables.TreePines222Night) as Graphics.BitmapType; }
        if (c == 15) { return WatchUi.loadResource(Rez.Drawables.TreePines312Night) as Graphics.BitmapType; }
        if (c == 16) { return WatchUi.loadResource(Rez.Drawables.TreePines316Night) as Graphics.BitmapType; }
        if (c == 17) { return WatchUi.loadResource(Rez.Drawables.TreePines322Night) as Graphics.BitmapType; }
        if (c == 18) { return WatchUi.loadResource(Rez.Drawables.TreeFir12Night) as Graphics.BitmapType; }
        if (c == 19) { return WatchUi.loadResource(Rez.Drawables.TreeFir16Night) as Graphics.BitmapType; }
        if (c == 20) { return WatchUi.loadResource(Rez.Drawables.TreeFir22Night) as Graphics.BitmapType; }
        if (c == 21) { return WatchUi.loadResource(Rez.Drawables.TreeCypress12Night) as Graphics.BitmapType; }
        if (c == 22) { return WatchUi.loadResource(Rez.Drawables.TreeCypress16Night) as Graphics.BitmapType; }
        if (c == 23) { return WatchUi.loadResource(Rez.Drawables.TreeCypress22Night) as Graphics.BitmapType; }
    }
    return null;
}
