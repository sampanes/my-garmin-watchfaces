using Toybox.Graphics;
using Toybox.Lang;
using Toybox.WatchUi;

// Generated by scripts/bake_weather.py; do not edit.
// The weather: 7 whole-face paintings, 416 px square, drawn behind the
// grasses. The Scene's weatherForCondition picks one.

const WX_NONE = -1;
const WX_RAIN_LIGHT = 0;
const WX_RAIN = 1;
const WX_STORM = 2;
const WX_SNOW = 3;
const WX_WIND = 4;
const WX_WIND_WINTER = 5;
const WX_WIND_SPRING = 6;
const WX_COUNT = 7;

// Weather painting i, day or night; the caller catches a refusal.
function loadWeatherBitmap(i as Lang.Number, night as Lang.Boolean) as Graphics.BitmapType? {
    if (!night) {
        if (i == 0) { return WatchUi.loadResource(Rez.Drawables.WxRainLight) as Graphics.BitmapType; }
        if (i == 1) { return WatchUi.loadResource(Rez.Drawables.WxRain) as Graphics.BitmapType; }
        if (i == 2) { return WatchUi.loadResource(Rez.Drawables.WxStorm) as Graphics.BitmapType; }
        if (i == 3) { return WatchUi.loadResource(Rez.Drawables.WxSnow) as Graphics.BitmapType; }
        if (i == 4) { return WatchUi.loadResource(Rez.Drawables.WxWind) as Graphics.BitmapType; }
        if (i == 5) { return WatchUi.loadResource(Rez.Drawables.WxWindWinter) as Graphics.BitmapType; }
        if (i == 6) { return WatchUi.loadResource(Rez.Drawables.WxWindSpring) as Graphics.BitmapType; }
    }
    if (night) {
        if (i == 0) { return WatchUi.loadResource(Rez.Drawables.WxRainLightNight) as Graphics.BitmapType; }
        if (i == 1) { return WatchUi.loadResource(Rez.Drawables.WxRainNight) as Graphics.BitmapType; }
        if (i == 2) { return WatchUi.loadResource(Rez.Drawables.WxStormNight) as Graphics.BitmapType; }
        if (i == 3) { return WatchUi.loadResource(Rez.Drawables.WxSnowNight) as Graphics.BitmapType; }
        if (i == 4) { return WatchUi.loadResource(Rez.Drawables.WxWindNight) as Graphics.BitmapType; }
        if (i == 5) { return WatchUi.loadResource(Rez.Drawables.WxWindWinterNight) as Graphics.BitmapType; }
        if (i == 6) { return WatchUi.loadResource(Rez.Drawables.WxWindSpringNight) as Graphics.BitmapType; }
    }
    return null;
}
